@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="badge bg-primary bg-opacity-10 text-primary p-3 rounded-circle mb-2">
                    <i class="bi bi-box-arrow-in-right fs-3"></i>
                </div>
                <h3 class="fw-bold">Ingreso al Sistema</h3>
                <p class="text-muted small">Estudiantes Univalle y Personal de Lavandería</p>
            </div>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@est.univalle.edu" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label small text-muted"></label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-pill shadow-sm mb-3">
                    Iniciar Sesión
                </button>

                <div class="text-center">
                    <span class="text-muted small">¿No tienes cuenta?</span>
                    <a asp-action="Registro" class="small fw-semibold text-primary text-decoration-none ms-1">
                        Regístrate como Estudiante
                    </a>
                </div>
            </form>

            <!-- Botones de relleno rápido para pruebas evaluativas -->
            <div class="mt-4 pt-3 border-top text-center">
                <span class="badge bg-light text-muted border mb-2">Autocompletar para pruebas rápidas:</span>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="llenarCredenciales('juan.perez@est.univalle.edu', 'Estudiante123!')">
                        Estudiante
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="llenarCredenciales('personal@univalle.edu', 'Personal123!')">
                        Personal
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function llenarCredenciales(email, pass) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = pass;
        }
    </script>
}
