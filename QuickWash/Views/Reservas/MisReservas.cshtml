@model List<Reserva>
@using QuickWash.Models
@{
    ViewData["Title"] = "Mis Reservas de Lavado";
    var activas = Model.Count(r => r.Estado == EstadosReserva.Pendiente || r.Estado == EstadosReserva.Proceso);
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-calendar2-check-fill text-primary me-2"></i> Mis Reservas
        </h2>
        <p class="text-muted mb-0">Gestiona tus turnos de lavado y evita filas en el campus.</p>
    </div>

    <div class="d-flex align-items-center gap-3">
        <!-- Indicador de Regla 2: Máximo 3 reservas -->
        <div class="card border-0 shadow-sm px-3 py-2 bg-white d-flex flex-row align-items-center gap-2">
            <i class="bi bi-collection text-primary fs-5"></i>
            <div>
                <div class="small text-muted" style="font-size: 0.75rem;">Reservas Activas (Máx. 3):</div>
                <div class="fw-bold @(activas >= 3 ? "text-danger" : "text-dark")">
                    @activas / 3 utilizadas
                </div>
            </div>
        </div>

        @if (activas < 3)
        {
            <a asp-action="Crear" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Nueva Reserva
            </a>
        }
        else
        {
            <button class="btn btn-secondary rounded-pill px-4 fw-semibold" disabled title="Has alcanzado el límite máximo de 3 reservas activas.">
                Límite de 3 Alcanzado
            </button>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="text-muted mb-3">
            <i class="bi bi-calendar-x display-4 text-secondary opacity-50"></i>
        </div>
        <h4 class="fw-bold text-dark">Aún no tienes reservas registradas</h4>
        <p class="text-muted small">Revisa la disponibilidad de las máquinas y aparta tu primer turno de lavado sin hacer fila.</p>
        <div class="mt-2">
            <a asp-action="Crear" class="btn btn-primary rounded-pill px-4">
                Crear Mi Primera Reserva
            </a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Máquina</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Prendas</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                    @r.CodigoReserva
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold">Lavadora #@r.Maquina.Numero.ToString("D2")</div>
                                <small class="text-muted">@r.Maquina.Nombre</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@r.Fecha.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@r.Fecha.ToString("dddd")</small>
                            </td>
                            <td>
                                <span class="badge bg-white text-dark border">
                                    <i class="bi bi-clock me-1 text-primary"></i>
                                    @r.HoraInicio.ToString(@"hh\:mm") - @r.HoraFin.ToString(@"hh\:mm")
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">
                                    <i class="bi bi-basket2 me-1"></i> @r.CantidadPrendas prendas
                                </span>
                            </td>
                            <td>
                                @if (r.Estado == EstadosReserva.Pendiente)
                                {
                                    <span class="badge badge-soft-warning"><i class="bi bi-hourglass me-1"></i> Pendiente</span>
                                }
                                else if (r.Estado == EstadosReserva.Proceso)
                                {
                                    <span class="badge badge-soft-primary"><i class="bi bi-arrow-repeat me-1"></i> En Proceso</span>
                                }
                                else if (r.Estado == EstadosReserva.Finalizada)
                                {
                                    <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i> Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-danger"><i class="bi bi-x-circle me-1"></i> Cancelada</span>
                                }
                            </td>
                            <td class="text-end">
                                <!-- REGLA 4: Solo se puede cancelar si está en estado 'Pendiente' -->
                                @if (r.Estado == EstadosReserva.Pendiente)
                                {
                                    <form asp-action="Cancelar" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas cancelar la reserva @r.CodigoReserva? Liberarás la máquina para otros estudiantes.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="reservaId" value="@r.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                            <i class="bi bi-x-circle me-1"></i> Cancelar
                                        </button>
                                    </form>
                                }
                                else if (r.Estado == EstadosReserva.Proceso)
                                {
                                    <span class="text-muted small" title="El ciclo ya ha iniciado. No es cancelable por el estudiante.">
                                        <i class="bi bi-lock-fill"></i> No cancelable
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
