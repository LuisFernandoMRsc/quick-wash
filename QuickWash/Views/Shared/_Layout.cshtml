@using QuickWash.Models
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quick Wash Univalle</title>
    
    <!-- Fuentes e Iconos -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Barra de Navegación -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm py-2 sticky-top" style="background: linear-gradient(135deg, #1e3a8a 0%, #0284c7 100%) !important;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" asp-controller="Home" asp-action="Index">
                    <span class="badge bg-white text-primary p-2 rounded-3 shadow-sm">
                        <i class="bi bi-water fs-5"></i>
                    </span>
                    <span>Quick Wash <small class="fw-normal text-white-50 fs-6">| Univalle</small></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarQuickWash" aria-controls="navbarQuickWash" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarQuickWash">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center gap-1" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center gap-1" asp-controller="Maquinas" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i> Disponibilidad en Vivo
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50 d-flex align-items-center gap-1" asp-controller="Home" asp-action="Reglas">
                                <i class="bi bi-info-circle"></i> Reglas de Uso
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Estudiante))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white d-flex align-items-center gap-1" asp-controller="Reservas" asp-action="MisReservas">
                                    <i class="bi bi-calendar-check"></i> Mis Reservas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-light btn-sm text-primary fw-semibold px-3 ms-lg-2 rounded-pill shadow-sm" asp-controller="Reservas" asp-action="Crear">
                                    <i class="bi bi-plus-circle-fill"></i> Reservar Lavadora
                                </a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true && User.IsInRole(Roles.Personal))
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-warning btn-sm text-dark fw-bold px-3 ms-lg-2 rounded-pill shadow-sm" asp-controller="Gestion" asp-action="Index">
                                    <i class="bi bi-sliders2-vertical"></i> Panel de Lavandería
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Sección de Usuario / Autenticación -->
                    <ul class="navbar-nav align-items-lg-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2 bg-white bg-opacity-10 px-3 py-1 rounded-pill" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <div class="text-start lh-1">
                                        <div class="fw-semibold small">@User.Identity.Name</div>
                                        <div class="text-white-50" style="font-size: 0.72rem;">@(User.IsInRole(Roles.Personal) ? "Personal Operador" : "Estudiante Univalle")</div>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3" aria-labelledby="userMenu">
                                    <li class="px-3 py-2 border-bottom text-muted small">
                                        <i class="bi bi-envelope"></i> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                    </li>
                                    @if (User.IsInRole(Roles.Estudiante))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Reservas" asp-action="MisReservas">
                                                <i class="bi bi-calendar-event me-2 text-primary"></i> Mis Reservas Activas
                                            </a>
                                        </li>
                                    }
                                    @if (User.IsInRole(Roles.Personal))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="Gestion" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2 text-warning"></i> Control de Operaciones
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger rounded-2 py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Ingresar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3 fw-semibold" asp-controller="Account" asp-action="Registro">
                                    <i class="bi bi-person-plus"></i> Registro Estudiantil
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Notificaciones Flash TempData -->
    <div class="container mt-3">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div>@TempData["MensajeExito"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div>@TempData["MensajeError"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MensajeInfo"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                <div>@TempData["MensajeInfo"]</div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Contenido Principal -->
    <main role="main" class="flex-grow-1 container py-3">
        @RenderBody()
    </main>

    <!-- Pie de Página -->
    <footer class="bg-white border-top py-4 mt-auto text-muted">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary text-white p-1 rounded-2"><i class="bi bi-water"></i></span>
                <span class="fw-bold text-dark">Quick Wash</span> — Sistema de Lavandería Universitaria Univalle
            </div>
            <div class="small">
                Dominio estudiantil: <span class="badge bg-light text-dark border">@@est.univalle.edu</span> | Máx. 3 reservas por alumno
            </div>
            <div class="small">
                &copy; @DateTime.Now.Year Universidad Privada del Valle
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
